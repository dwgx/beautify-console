{
    "name": "beautify-console",
    "displayName": "美化控制台 Beautify Console",
    "description": "VS Code 一站式可视化美化面板:字体/布局/编辑器/动画/多区域背景图/圆角/主题,支持轮播、自定义 CSS、配置导入导出。A visual beautify panel for VS Code.",
    "version": "1.0.5",
    "publisher": "dwgx",
    "license": "MIT",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "theme",
        "background",
        "beautify",
        "ui",
        "jetbrains",
        "美化"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/dwgx/beautify-console"
    },
    "extensionDependencies": [
        "subframe7536.custom-ui-style"
    ],
    "extensionPack": [
        "baran-wang.vscode-theme-jetbrains-new-ui",
        "fogio.jetbrains-product-icon-theme"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "scripts": {
        "test": "node --test \"test/*.test.js\""
    },
    "contributes": {
        "commands": [
            {
                "command": "beautify.openPanel",
                "title": "美化: 打开控制台"
            },
            {
                "command": "bgSwitcher.fullWindow",
                "title": "美化: 背景-全窗口"
            },
            {
                "command": "bgSwitcher.codeOnly",
                "title": "美化: 背景-仅代码区"
            },
            {
                "command": "bgSwitcher.off",
                "title": "美化: 背景-关闭"
            },
            {
                "command": "beautify.panicDisableCustomCss",
                "title": "美化: 紧急关闭自定义 CSS"
            },
            {
                "command": "beautify.openCustomCss",
                "title": "美化: 编辑自定义 CSS"
            }
        ],
        "keybindings": [
            {
                "command": "beautify.panicDisableCustomCss",
                "key": "ctrl+alt+shift+f12",
                "mac": "cmd+alt+shift+f12"
            }
        ],
        "configuration": {
            "title": "美化控制台",
            "properties": {
                "beautify.codeOpacity": {
                    "type": "number",
                    "default": 0.22,
                    "minimum": 0.05,
                    "maximum": 0.8,
                    "description": "仅代码区背景图的不透明度(独立于全窗口)"
                },
                "beautify.customCss.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "是否注入自定义 CSS(cus-custom.css)。写坏界面时可用「美化: 紧急关闭自定义 CSS」一键关掉,快捷键 Cmd/Ctrl+Alt+Shift+F12"
                }
            }
        }
    }
}